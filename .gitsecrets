# Git Secrets Configuration
# Patterns to prevent committing secrets

# Airtable
pat[a-zA-Z0-9]{14}\.[a-zA-Z0-9]{64}
key[a-zA-Z0-9]{14}

# Generic API keys
AIRTABLE_PAT=.+
AIRTABLE_API_KEY=.+
SUPABASE_PUBLISHABLE_KEY=.+

# Base64 encoded secrets
[A-Za-z0-9+/]{40,}={0,2}

# Common secret patterns
api[_-]?key[_-]?=.+
secret[_-]?key[_-]?=.+
password[_-]?=.+
token[_-]?=.+
