    {
      "parameters": {
        "jsCode": "// Get the first input item (from webhook)\nconst input = items[0].json.body;\n\n// Extract order-level data\nconst orderId = input.orderId;\nconst orderNumber = parseInt(orderId.replace(/\\D/g, ''), 10); // extract number only\n\nconst uniqueOrderRecordId = input.uniqueOrderRecordId;\nconst orderedBy = input.orderedBy;\nconst deliveryParty = input.deliveryParty;\nconst dateOrdered = input.dateOrdered;\nconst pickedAt = input.metadata?.pickedAt;\nconst pickerEmail = input.metadata?.pickerEmail;\n\n// Map pickedItems to separate line items\nconst output = input.pickedItems.map((line, index) => {\n  return {\n    json: {\n      lineNumber: index + 1,\n      orderId: orderId,\n      orderNumber: orderNumber, // 👈 added this\n      uniqueOrderRecordId: uniqueOrderRecordId,\n      orderedBy: orderedBy,\n      deliveryParty: deliveryParty,\n      dateOrdered: dateOrdered,\n      pickedAt: pickedAt,\n      pickerEmail: pickerEmail,\n      stockOrderId: line.stockOrderId,\n      deviceType: line.deviceType,\n      quantity: line.quantity,\n      stockAvailability: line.stockAvailability,\n      pickStatus: line.pickStatus,\n      packer: line.packer,\n      terminalSerialNumber: line.terminalSerialNumber,\n      cradleSerialNumber: line.cradleSerialNumber,\n      chargerSerialNumber: line.chargerSerialNumber,\n      cashConnectSerialNumber: line.cashConnectSerialNumber,\n      chargerPacked: line.chargerPacked,\n      cables: line.cables,\n      itemCode: line.itemCode,\n      itemDescription: line.itemDescription\n    }\n  };\n});\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        48
      ],
      "id": "ecb38cf9-71d1-4306-8a88-e9f2832c825c",
      "name": "Flatten array"
    },
