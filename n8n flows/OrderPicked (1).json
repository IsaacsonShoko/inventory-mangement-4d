    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Your Order Has Been Picked</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; background-color: #f4f4f4;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f4f4f4; padding: 20px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #9C0DD9 0%, #7209B7 100%); padding: 40px 30px; text-align: center;\">\n              <h1 style=\"margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;\">Your Order Has Been Picked 🛒</h1>\n              <p style=\"margin: 10px 0 0 0; color: #ffffff; font-size: 16px; opacity: 0.95;\">Here's what we prepared for you</p>\n            </td>\n          </tr>\n\n          <!-- Order Details -->\n          <tr>\n            <td style=\"padding: 30px;\">\n              <p style=\"margin: 0 0 20px 0; color: #333333; font-size: 16px; line-height: 1.6;\">\n                Hi <strong>Isaacson Shoko</strong>,\n              </p>\n              <p style=\"margin: 0 0 25px 0; color: #666666; font-size: 15px; line-height: 1.6;\">\n                Your order has been picked. Below are the details and current availability status of each item.\n              </p>\n\n              <!-- Out of Stock Warning (conditional) -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffebee; border-left: 4px solid #d32f2f; border-radius: 4px; margin-bottom: 20px;\">\n                <tr>\n                  <td style=\"padding: 20px;\">\n                    <h3 style=\"margin: 0 0 8px 0; color: #d32f2f; font-size: 16px; font-weight: bold;\">⚠️ Some Items Are Out of Stock</h3>\n                    <p style=\"margin: 0; color: #b71c1c; font-size: 14px;\">Items marked as <strong>Out of stock</strong> will be fulfilled as soon as they become available.</p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Order Info -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f8f9fa; border-radius: 6px; margin-bottom: 25px;\">\n                <tr>\n                  <td style=\"padding: 20px;\">\n                    <table width=\"100%\" cellpadding=\"5\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"color: #666666; font-size: 14px; padding: 8px 0;\">Order Number:</td>\n                        <td style=\"color: #333333; font-size: 14px; font-weight: bold; text-align: right; padding: 8px 0;\">15</td>\n                      </tr>\n                      <tr>\n                        <td style=\"color: #666666; font-size: 14px; padding: 8px 0;\">Order Date:</td>\n                        <td style=\"color: #333333; font-size: 14px; font-weight: bold; text-align: right; padding: 8px 0;\">19 Oct 2025</td>\n                      </tr>\n                      <tr>\n                        <td style=\"color: #666666; font-size: 14px; padding: 8px 0;\">Total Items:</td>\n                        <td style=\"color: #333333; font-size: 14px; font-weight: bold; text-align: right; padding: 8px 0;\">3 items</td>\n                      </tr>\n                      <tr>\n                        <td style=\"color: #666666; font-size: 14px; padding: 8px 0;\">Picked By:</td>\n                        <td style=\"color: #333333; font-size: 14px; font-weight: bold; text-align: right; padding: 8px 0;\">Isaacson Shoko</td>\n                      </tr>\n                      <tr>\n                        <td style=\"color: #666666; font-size: 14px; padding: 8px 0;\">Picked At:</td>\n                        <td style=\"color: #333333; font-size: 14px; font-weight: bold; text-align: right; padding: 8px 0;\">19/10/2025, 22:11:27</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Items -->\n              <h2 style=\"margin: 30px 0 15px 0; color: #333333; font-size: 20px; font-weight: bold; border-bottom: 2px solid #9C0DD9; padding-bottom: 10px;\">\n                Items in This Order\n              </h2>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 25px;\">\n                <tr>\n                  <td style=\"padding: 15px 0; border-bottom: 1px solid #eeeeee;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"vertical-align: top;\">\n                          <h3 style=\"margin: 0 0 5px 0; color: #333333; font-size: 16px; font-weight: bold;\">clover-flex-device</h3>\n                          <p style=\"margin: 0 0 8px 0; color: #666666; font-size: 13px;\">Stock Order ID: 15</p>\n                          <div style=\"margin-top: 8px;\">\n                            <span style=\"display: inline-block; background-color: #e8f5e9; color: #2e7d32; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-right: 8px;\">\n                              In stock\n                            </span>\n                            <span style=\"display: inline-block; background-color: #f0e6f9; color: #7209B7; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600;\">\n                              Qty: 1\n                            </span>\n                          </div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 15px 0; border-bottom: 1px solid #eeeeee;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"vertical-align: top;\">\n                          <h3 style=\"margin: 0 0 5px 0; color: #333333; font-size: 16px; font-weight: bold;\">verizon-z9</h3>\n                          <p style=\"margin: 0 0 8px 0; color: #666666; font-size: 13px;\">Stock Order ID: 15</p>\n                          <div style=\"margin-top: 8px;\">\n                            <span style=\"display: inline-block; background-color: #ffebee; color: #d32f2f; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-right: 8px;\">\n                              Out of stock\n                            </span>\n                            <span style=\"display: inline-block; background-color: #f0e6f9; color: #7209B7; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600;\">\n                              Qty: 1\n                            </span>\n                          </div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 15px 0; border-bottom: 1px solid #eeeeee;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"vertical-align: top;\">\n                          <h3 style=\"margin: 0 0 5px 0; color: #333333; font-size: 16px; font-weight: bold;\">n950-smart-terminal-side</h3>\n                          <p style=\"margin: 0 0 8px 0; color: #666666; font-size: 13px;\">Stock Order ID: 15</p>\n                          <div style=\"margin-top: 8px;\">\n                            <span style=\"display: inline-block; background-color: #e8f5e9; color: #2e7d32; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-right: 8px;\">\n                              In stock\n                            </span>\n                            <span style=\"display: inline-block; background-color: #f0e6f9; color: #7209B7; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600;\">\n                              Qty: 1\n                            </span>\n                          </div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Next Steps -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #e8f5e9; border-left: 4px solid #4caf50; border-radius: 4px; margin: 25px 0;\">\n                <tr>\n                  <td style=\"padding: 20px;\">\n                    <h3 style=\"margin: 0 0 10px 0; color: #2e7d32; font-size: 16px; font-weight: bold;\">📦 Next Steps</h3>\n                    <ul style=\"margin: 0; padding-left: 20px; color: #555555; font-size: 14px; line-height: 1.8;\">\n                      <li>Items in stock will be dispatched as planned</li>\n                      <li>Out of stock items will be fulfilled once available</li>\n                      <li>You'll receive further updates via email</li>\n                    </ul>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin: 25px 0 10px 0; color: #666666; font-size: 14px; line-height: 1.6;\">\n                If you have any questions about your order, please don't hesitate to contact us.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f8f9fa; padding: 25px 30px; text-align: center; border-top: 1px solid #eeeeee;\">\n              <p style=\"margin: 0 0 10px 0; color: #999999; font-size: 13px;\">\n                This is an automated confirmation email. Please do not reply to this message.\n              </p>\n              <p style=\"margin: 0; color: #666666; font-size: 14px; font-weight: bold;\">\n                4D Logistics Inventory Management System\n              </p>\n              <p style=\"margin: 8px 0 0 0; color: #999999; font-size: 12px;\">\n                © 2025 All rights reserved\n              </p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
