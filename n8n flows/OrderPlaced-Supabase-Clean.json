{
  "name": "OrderPlaced-Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-placed",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-400, 240],
      "webhookId": "order-placed"
    },
    {
      "parameters": {
        "jsCode": "// Extract order data from webhook payload\nconst input = items[0].json;\n\n// Build email-friendly summary\nconst itemsList = input.cartItems.map((item, idx) => \n  `${idx + 1}. ${item.itemName} - Qty: ${item.quantity}`\n).join('\\n');\n\nconst deliveryInfo = input.deliveryParty === 'Technician' \n  ? `Technician: ${input.formData.technician || 'N/A'}\\nRegion: ${input.formData.region || 'N/A'}`\n  : input.deliveryParty === 'Regional Warehouse'\n  ? `Regional Warehouse: ${input.formData.region || 'N/A'}`\n  : `Recipient: ${input.formData.recipientName || 'N/A'}\\nCompany: ${input.formData.recipientCompanyName || 'N/A'}\\nAddress: ${input.formData.recipientAddress || 'N/A'}`;\n\nreturn [{\n  json: {\n    orderId: input.orderId,\n    orderNumber: input.autoGeneratedOrderId,\n    dateOrdered: input.dateOrdered,\n    orderedBy: input.orderedBy,\n    orderedByEmail: input.formData.onBehalfOf || input.orderedBy,\n    deliveryParty: input.deliveryParty,\n    totalItems: input.totalItems,\n    totalQuantity: input.totalQuantity,\n    itemsList: itemsList,\n    deliveryInfo: deliveryInfo,\n    category: input.formData.itemCategory,\n    nature: input.formData.itemNature\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 240],
      "id": "format-data",
      "name": "Format Email Data"
    },
    {
      "parameters": {
        "fromEmail": "admin@4danalytics.co.za",
        "toEmail": "={{ $json.orderedByEmail }}",
        "subject": "Order {{ $json.orderId }} - Placed Successfully",
        "emailFormat": "html",
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n</head>\n<body style=\"font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px; margin: 0;\">\n  <table width=\"600\" style=\"background-color: #ffffff; border-radius: 8px; margin: 0 auto; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\n    <!-- Header -->\n    <tr>\n      <td style=\"background: linear-gradient(135deg, #9C0DD9 0%, #7209B7 100%); padding: 40px 30px; text-align: center; border-radius: 8px 8px 0 0;\">\n        <h1 style=\"margin: 0; color: #ffffff; font-size: 28px;\">Order Placed Successfully</h1>\n      </td>\n    </tr>\n    \n    <!-- Body -->\n    <tr>\n      <td style=\"padding: 40px 30px;\">\n        <p style=\"font-size: 16px; color: #333; margin-top: 0;\">Hello,</p>\n        <p style=\"font-size: 16px; color: #333;\">Your order has been placed successfully and is now in the picking queue.</p>\n        \n        <!-- Order Details Box -->\n        <table width=\"100%\" style=\"background-color: #f8f9fa; border-radius: 6px; margin: 25px 0; border-left: 4px solid #9C0DD9;\">\n          <tr>\n            <td style=\"padding: 20px;\">\n              <p style=\"margin: 8px 0; color: #333; font-size: 14px;\"><strong>Order Number:</strong> {{ $json.orderId }}</p>\n              <p style=\"margin: 8px 0; color: #333; font-size: 14px;\"><strong>Date Ordered:</strong> {{ $json.dateOrdered }}</p>\n              <p style=\"margin: 8px 0; color: #333; font-size: 14px;\"><strong>Ordered By:</strong> {{ $json.orderedBy }}</p>\n              <p style=\"margin: 8px 0; color: #333; font-size: 14px;\"><strong>Category:</strong> {{ $json.category }}</p>\n              <p style=\"margin: 8px 0; color: #333; font-size: 14px;\"><strong>Delivery Party:</strong> {{ $json.deliveryParty }}</p>\n            </td>\n          </tr>\n        </table>\n        \n        <!-- Items Section -->\n        <h3 style=\"color: #333; margin-top: 30px; margin-bottom: 15px;\">Order Items ({{ $json.totalItems }} items, {{ $json.totalQuantity }} units)</h3>\n        <div style=\"background-color: #f8f9fa; border-radius: 6px; padding: 20px;\">\n          <pre style=\"margin: 0; font-family: monospace; font-size: 13px; color: #555; white-space: pre-wrap;\">{{ $json.itemsList }}</pre>\n        </div>\n        \n        <!-- Delivery Info -->\n        <h3 style=\"color: #333; margin-top: 30px; margin-bottom: 15px;\">Delivery Information</h3>\n        <div style=\"background-color: #f8f9fa; border-radius: 6px; padding: 20px;\">\n          <pre style=\"margin: 0; font-family: monospace; font-size: 13px; color: #555; white-space: pre-wrap;\">{{ $json.deliveryInfo }}</pre>\n        </div>\n        \n        <p style=\"font-size: 14px; color: #666; margin-top: 30px; margin-bottom: 0;\">You will receive another notification when your order is picked and ready for dispatch.</p>\n      </td>\n    </tr>\n    \n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color: #f8f9fa; padding: 25px; text-align: center; border-radius: 0 0 8px 8px;\">\n        <p style=\"color: #999999; font-size: 13px; margin: 0;\">4D Analytics Inventory Management System</p>\n        <p style=\"color: #999999; font-size: 12px; margin: 8px 0 0 0;\">This is an automated message, please do not reply.</p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [120, 240],
      "id": "send-email",
      "name": "Send Email",
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Order placed notification sent\", \"orderId\": $json.orderId } }}",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [400, 240]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Email Data": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "notes": "Clean version - Only handles email notifications. No database operations. App is single source of truth for order creation."
  }
}
