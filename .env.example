VITE_SUPABASE_PROJECT_ID=your_value_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_value_here
VITE_SUPABASE_URL=your_value_here

# n8n Webhook Configuration (AWS Lambda Proxy URLs)
# These should point to your Lambda endpoints (HTTPS) that proxy to n8n (HTTP)
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/order-placed
VITE_N8N_ORDER_PLACED_WEBHOOK_URL=your_lambda_endpoint_here
VITE_N8N_ORDER_PICKED_WEBHOOK_URL=your_lambda_endpoint_here
VITE_N8N_ORDER_DISPATCHED_WEBHOOK_URL=your_lambda_endpoint_here

# Optional: Legacy webhook URLs (not used if Lambda URLs are set)
VITE_N8N_SUBMIT_ORDER_WEBHOOK_URL=
VITE_N8N_ORDER_MANIFEST_WEBHOOK_URL=
