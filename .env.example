VITE_SUPABASE_PROJECT_ID=your_value_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_value_here
VITE_SUPABASE_URL=your_value_here

# n8n Webhook Configuration (Netlify Functions URLs)
# These should point to your Netlify Function endpoints (HTTPS) that proxy to n8n (HTTP)
# Example: https://your-site.netlify.app/.netlify/functions/n8n-proxy/order-placed
VITE_N8N_ORDER_PLACED_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/n8n-proxy/order-placed
VITE_N8N_ORDER_PICKED_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/n8n-proxy/order-picked
VITE_N8N_ORDER_DISPATCHED_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/n8n-proxy/order-dispatched

# Optional: Legacy webhook URLs (not used if Lambda URLs are set)
VITE_N8N_SUBMIT_ORDER_WEBHOOK_URL=
VITE_N8N_ORDER_MANIFEST_WEBHOOK_URL=
